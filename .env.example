# ─── Womo Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# LOCAL-ONLY: the app runs on an analyst laptop (macOS) against the shared
# cloud Supabase. The values marked [required] are all a run needs.
# Full setup guide: docs/LOCAL_RUNBOOK.md

# ─── Database [required] ─────────────────────────────────────────────────────
# The SHARED cloud Supabase connection-pooler URL (same database for every
# analyst — analyses you run locally appear for everyone). Get it from the
# team vault / Supabase dashboard → Connect → Connection pooler.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# ─── API Keys ─────────────────────────────────────────────────────────────────

# [required] Google AI Studio (Gemini 2.5 Flash — extraction, themes, symbols)
GEMINI_API_KEY=your-google-ai-studio-key

# [required for brand analysis] Google Maps Places API
GOOGLE_MAPS_API_KEY=your-google-maps-key

# [optional] OpenAI Whisper transcription fallback — leave unset if not using
# OPENAI_API_KEY=your-openai-key

# ─── Local tuning [optional] ──────────────────────────────────────────────────

# Analysis race deadline in ms. Default 300000 (5 min). May be raised for hard
# creators, e.g. 600000.
# ANALYSIS_TIMEOUT_MS=300000

# Browser launch profile override. Normally AUTO-DETECTED (container inside
# Docker → container profile with --single-process; anywhere else → local
# profile without it). Set only to force one explicitly.
# BROWSER_PROFILE=local

# Phase admission bounds (S3a). How many phases of each resource class may run
# at once, ACROSS all concurrent analyses. Raise only against the memory
# telemetry in pipeline_runs.error_log.memory, never on a hunch.
#
# Browser: the context pool holds 5 and a browser phase peaks at 1-2 contexts,
# so 3 can reach the cap — at which point the pool creates contexts OVER it
# instead of blocking, which is the memory blowup this bound exists to prevent.
# LLM: derive fires two Gemini calls, so 4 means up to 8 in flight.
# PHASE_BROWSER_CONCURRENCY=2
# PHASE_LLM_CONCURRENCY=4

# Server port (defaults to 3000)
# PORT=3000
