# ─── Womo Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# LOCAL-FIRST: the app is designed to run on an analyst laptop (macOS) against
# the shared cloud Supabase. The values marked [required] are all a local run
# needs; the [hosted-only] section matters only for the Railway/Vercel fallback
# deployment. Full setup guide: docs/LOCAL_RUNBOOK.md

# ─── Database [required] ─────────────────────────────────────────────────────
# The SHARED cloud Supabase connection-pooler URL (same database for every
# analyst and for the hosted fallback — analyses you run locally appear for
# everyone). Get it from the team vault / Supabase dashboard → Connect →
# Connection pooler.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# ─── API Keys ─────────────────────────────────────────────────────────────────

# [required] Google AI Studio (Gemini 2.5 Flash — extraction, themes, symbols)
GEMINI_API_KEY=your-google-ai-studio-key

# [required for brand analysis] Google Maps Places API
GOOGLE_MAPS_API_KEY=your-google-maps-key

# [optional] OpenAI Whisper transcription fallback — leave unset if not using
# OPENAI_API_KEY=your-openai-key

# ─── Auth [required] ──────────────────────────────────────────────────────────
# Local note: cookies are per-origin, so your local PIN/secret may differ from
# the hosted deployment's — they are independent logins.

# Pilot access PIN — what you type on the login screen
PIN_CODE=your-pilot-pin

# Secret used to HMAC-sign the auth cookie — must be long and random.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-with-the-node-one-liner-above

# ─── Local tuning [optional] ──────────────────────────────────────────────────

# Analysis race deadline in ms. Default 300000 (5 min — the hosted value, which
# must stay below Railway's gateway cutoff). Locally there is no gateway, so you
# may raise it for hard creators, e.g. 600000.
# ANALYSIS_TIMEOUT_MS=300000

# Browser launch profile override. Normally AUTO-DETECTED (container inside
# Docker → container profile with --single-process; anywhere else → local
# profile without it). Set only to force one explicitly.
# BROWSER_PROFILE=local

# Server port (defaults to 3000 locally)
# PORT=3000

# ─── Hosted-only (Railway/Vercel fallback deployment) ─────────────────────────
# Not needed for a local run. In Railway production these are REQUIRED
# (crash-fast validation): PIN_CODE, GEMINI_API_KEY, DATABASE_URL, JWT_SECRET,
# ALLOWED_ORIGINS.

# Comma-separated allowed frontend origins (CORS) — e.g. the Vercel URL
# ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# NODE_ENV=production
# PORT=8080
